# Copy to .env and fill in. Never commit .env.

# Meta Model API key from https://dev.meta.ai/ (server side only).
# Leave empty to use fixtures and replay without any model calls.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE=https://api.meta.ai/v1

# Output token limit per model call (capped at 2500 in code).
META_MAX_OUTPUT_TOKENS=2000

GOALFAULT_DB_PATH=./data/goalfault.db

# Set this before running anywhere other than localhost.
# All write requests must then send it as the X-GoalFault-Token header.
# See docs/security.md.
GOALFAULT_ADMIN_TOKEN=
